        <mxCell id="step_dev" value="Developer Workstation&#xa;git push origin main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#94a3b8;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
