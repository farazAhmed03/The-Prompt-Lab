        <!-- CONTAINER 1: FRONTEND + NGINX -->
        <mxCell id="c_frontend" value="1. mern-frontend&#xa;(React 18 Vite + Nginx)&#xa;Image: nginx-unprivileged:alpine&#xa;User: nginx (UID 101)&#xa;&#xa;Ports:&#xa;• Host 80  ➔  Container 8080 (301 Redirect)&#xa;• Host 443 ➔  Container 8443 (HTTPS SSL)&#xa;&#xa;Volume Mount:&#xa;/etc/letsencrypt :ro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083344;strokeColor=#06b6d4;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="740" width="220" height="190" as="geometry" />
        </mxCell>

        <!-- CONTAINER 2: BACKEND API -->
        <mxCell id="c_backend" value="2. mern-backend&#xa;(Node.js Express REST API)&#xa;Image: node:20-alpine&#xa;User: node (UID 1000)&#xa;&#xa;Port: 5000 (Internal Bridge)&#xa;&#xa;Endpoints:&#xa;• /api/prompts&#xa;• /api/status (Health Check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="740" width="230" height="190" as="geometry" />
        </mxCell>

        <!-- CONTAINER 3: MONGODB -->
        <mxCell id="c_mongodb" value="3. mern-mongodb&#xa;(Database Engine)&#xa;Image: mongo:7.0&#xa;&#xa;Port: 27017 (Internal Only)&#xa;Isolated from Public Internet!&#xa;&#xa;Persistent Volume:&#xa;mongo-data ➔ /data/db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#22c55e;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="740" width="220" height="190" as="geometry" />
        </mxCell>

        <!-- CONTAINER 4: MONGO-EXPRESS -->
        <mxCell id="c_express" value="4. mern-mongo-express&#xa;Database Management Dashboard&#xa;Port: 8081  |  Basic Auth Protected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b0764;strokeColor=#a855f7;fontColor=#ffffff;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="910" y="955" width="490" height="60" as="geometry" />
        </mxCell>

