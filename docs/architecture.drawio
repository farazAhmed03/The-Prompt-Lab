        <!-- 7. CI/CD PIPELINE COLUMN (LEFT SIDE) -->
        <mxCell id="group_cicd" value="CI/CD Automation Pipeline (GitHub Actions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#2563eb;strokeWidth=2;dashed=1;fontColor=#60a5fa;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
