        <mxCell id="step_repo" value="GitHub Repository: farazAhmed03/The-Prompt-Lab&#xa;Trigger: Push event on main branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#3b82f6;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="530" width="350" height="50" as="geometry" />
        </mxCell>

        <mxCell id="step_ci" value="Stage 1: Continuous Integration (ci.yml)&#xa;• Node.js &amp; npm dependency setup&#xa;• Code linting &amp; syntax validation&#xa;• Frontend Vite &amp; Backend build tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#3b82f6;fontColor=#bfdbfe;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="350" height="75" as="geometry" />
        </mxCell>

        <mxCell id="step_cd" value="Stage 2: Continuous Deployment (cd.yml)&#xa;• Trigger: workflow_run (CI Success)&#xa;• SSH Action: appleboy/ssh-action@v1.2.0&#xa;• Secrets: EC2_IP, EC2_USER, EC2_SSH_KEY, EC2_PORT&#xa;• Connects to EC2 Port 22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#3b82f6;fontColor=#bfdbfe;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="735" width="350" height="95" as="geometry" />
        </mxCell>

        <mxCell id="step_script" value="Dedicated Deployment Runner: scripts/deploy.sh&#xa;Executes via native #!/usr/bin/env bash on EC2:&#xa;[1/5] Git pull latest changes &amp; hard reset&#xa;[2/5] Verify .env configuration (zero-overwrite safety)&#xa;[3/5] Auto-provision SSL certificate via Certbot&#xa;[4/5] docker compose up -d --build --remove-orphans&#xa;[5/5] Automated curl health check retry loop (10x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#a7f3d0;fontSize=11;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="870" width="350" height="150" as="geometry" />
        </mxCell>

