# ==============================================================================
# Sample Terraform Variables Template (Safe for Version Control)
# ==============================================================================
# Copy this file to 'terraform.tfvars' and assign your actual values:
# cp terraform.tfvars.example terraform.tfvars

aws_region    = "us-east-1"
key_name      = "your-aws-key-name" # Key Pair name created in AWS Console (without .pem)
instance_type = "t3.micro"
domain_name   = "devops-project-demo.study"
